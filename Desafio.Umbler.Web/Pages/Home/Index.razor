@page "/"
@using Desafio.Umbler.Application.DTOs
@using Desafio.Umbler.Application.Exceptions
@using Desafio.Umbler.Application.Interfaces
@using System.Text.RegularExpressions
@inject IDomainService DomainService

<h3 class="text-center mb-4">Consulta de DNS</h3>

<div class="container py-4">
    <div class="row">
        <div class="col-lg-9 col-md-8">
            @* Adicionado @onkeyup para permitir pesquisa com a tecla Enter *@
            <input class="form-control form-control-lg @(inputClass)"
                   placeholder="Digite o Domínio que deseja pesquisar"
                   @bind="_domain"
                   @bind:event="oninput"
                   @onkeyup="HandleKeyUp" />
        </div>

        <div class="col-lg-3 col-md-4">
            @* Removido o disabled baseado na validação, mantendo apenas para o loading *@
            <button class="btn btn-success w-100 btn-lg"
                    @onclick="SearchAsync"
                    disabled="@_loading">
                @if (_loading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span> Pesquisando...</span>
                }
                else
                {
                    <span>Pesquisar</span>
                }
            </button>
        </div>
    </div>

    @* Exibição de erros amigável *@
    @if (_error is not null)
    {
        <div class="alert alert-warning alert-dismissible fade show mt-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Atenção:</strong> @_error.Message
            <button type="button" class="btn-close" @onclick="() => _error = null"></button>
        </div>
    }

    @* Resultado da Pesquisa *@
    @if (_result is not null)
    {
        <div class="mt-4 animate__animated animate__fadeIn">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Dados do Domínio: @_result.Name</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-4"><b>IP:</b> @_result.Ip</div>
                        <div class="col-sm-8"><b>Hospedado em:</b> @_result.HostedAt</div>
                    </div>
                    <hr />
                    <details class="mt-2">
                        <summary class="btn btn-outline-secondary btn-sm">Ver WHOIS completo</summary>
                        <pre class="mt-3 p-3 bg-light border rounded" style="white-space: pre-wrap; font-size: 0.85rem;">@_result.WhoIs</pre>
                    </details>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string _domain = "";
    private bool _loading;
    private DomainInfoDto? _result;
    private UiError? _error;
    private string inputClass = "";

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchAsync();
    }

    private async Task SearchAsync()
    {
        _error = null;
        _result = null;
        inputClass = "";

        var domain = (_domain ?? "").Trim().ToLowerInvariant();

        // Validação Client-Side com Regex
        if (!IsValidDomain(domain))
        {
            inputClass = "is-invalid";
            _error = new UiError("invalid_input", "Por favor, insira um domínio válido (ex: google.com ou umbler.com.br).");
            return;
        }

        _loading = true;
        try
        {
            _result = await DomainService.GetAsync(domain);
            inputClass = "is-valid";
        }
        catch (InvalidDomainException ex)
        {
            _error = new UiError("invalid_domain", ex.Message);
            inputClass = "is-invalid";
        }
        catch (ExternalLookupException ex)
        {
            _error = new UiError("external_service_unavailable", "Não foi possível consultar os dados externos agora. Tente novamente em instantes.");
        }
        catch (Exception)
        {
            _error = new UiError("unexpected_error", "Ocorreu um erro inesperado no servidor.");
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool IsValidDomain(string domain)
    {
        if (string.IsNullOrWhiteSpace(domain)) return false;

        // Regex para validar domínio       
        var regex = new Regex(@"^(?!-)[A-Za-z0-9-]+([\-\.]{1}[a-z0-9]+)*\.[A-Za-z]{2,63}$");

        return regex.IsMatch(domain);
    }

    public record UiError(string Code, string Message);
}